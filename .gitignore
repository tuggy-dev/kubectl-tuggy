# Binaries
/bin/
/dist/
/kubectl-tuggy
*.exe
*.test
*.out

# Go
/vendor/
go.work
go.work.sum

# OpenTofu / Terraform (state and plans can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
*.tfvars.json
# Test fixtures, such as expected variables files, are kept.
!**/testdata/**

# Credentials and kubeconfigs (anchored so packages like internal/kubeconfig
# and test fixtures under testdata/ are not ignored)
/*credentials*.json
/*.pem
/*.key
/kubeconfig*
*.kubeconfig

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
